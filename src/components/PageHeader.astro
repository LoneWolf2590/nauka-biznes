---
import Motif from "./Motif.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="hero hero--page">
  <Motif variant="hero" />
  <div class="hero__inner container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="hero__lead">{lead}</p>}
  </div>
</header>
