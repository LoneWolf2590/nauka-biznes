---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { inicjaly } from "../lib/format";
import { osobaDialogId } from "../lib/dialogs";
import { withBase } from "../lib/paths";

interface Props {
  slug: string;
  name: string;
  role: string;
  affiliation?: string;
  bio?: string;
  photo?: ImageMetadata;
  photoAlt?: string;
    hasNote?: boolean;
}

const { slug, name, role, affiliation, bio, photo, photoAlt, hasNote = false } = Astro.props;
const initials = inicjaly(name);
---

<article class="person-card">
  <div class="person-card__portrait">
    {photo && photoAlt ? (
      <Image src={photo} alt={photoAlt} widths={[260, 520]} sizes="(max-width: 640px) 220px, 260px" format="webp" loading="lazy" />
    ) : (
      <div class="person-card__photo-empty" role="img" aria-label={`Zdjęcie osoby ${name} zostanie uzupełnione`}>
        <span aria-hidden="true">{initials}</span>
        <small>Zdjęcie w przygotowaniu</small>
      </div>
    )}
  </div>
  <div class="person-card__content">
    <h2>{name}</h2>
    <p class="person-card__role">{role}</p>
    {affiliation && <p class="person-card__affiliation">{affiliation}</p>}
    {bio && <p class="person-card__bio">{bio}</p>}
    {hasNote && (
      <p class="person-card__more">
                <a href={withBase(`zespol/#${osobaDialogId(slug)}`)} data-overlay-open={osobaDialogId(slug)}>
          Dowiedz się więcej <span aria-hidden="true">→</span>
        </a>
      </p>
    )}
  </div>
</article>
