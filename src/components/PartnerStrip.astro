---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Partner {
  name: string;
  logo: ImageMetadata;
  url?: string;
}

interface Props {
  partners: Partner[];
}

const { partners } = Astro.props;

const liczbaPodgladu = 6;
---

<section class="section partners" aria-labelledby="partners-title">
  <div class="container partners__inner">
    <div class="partners__intro">
      <p class="eyebrow">Współpraca</p>
      <h2 id="partners-title">Partnerzy projektu</h2>
      <p>
        Projekt rozwijamy razem z uczelniami, przedsiębiorstwami i instytucjami publicznymi,
        które dzielą się doświadczeniem i współtworzą rekomendacje.
      </p>
    </div>

    {partners.length > 0 ? (
      <ul class="partners__grid">
        {partners.map((partner) => (
          <li>
            {partner.url ? (
              <a href={partner.url} class="partner-logo" rel="noopener">
                <Image src={partner.logo} alt={partner.name} widths={[180, 280]} sizes="180px" format="webp" loading="lazy" />
              </a>
            ) : (
              <div class="partner-logo">
                <Image src={partner.logo} alt={partner.name} widths={[180, 280]} sizes="180px" format="webp" loading="lazy" />
              </div>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="partners__preview">
        <ul class="partners__grid" aria-hidden="true">
          {Array.from({ length: liczbaPodgladu }, (_, index) => (
            <li>
              <div class="partner-logo partner-logo--placeholder">
                <span>Logo partnera {index + 1}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
