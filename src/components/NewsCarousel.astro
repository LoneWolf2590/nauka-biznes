---
import type { CollectionEntry } from "astro:content";
import NewsCard from "./NewsCard.astro";

interface Props {
  entries: CollectionEntry<"aktualnosci">[];
    perView?: number;
}

const { entries, perView = 3 } = Astro.props;
const hasControls = entries.length > perView;
---

<div class="news-carousel" data-news-carousel>
  <div
    class="news-carousel__viewport"
    data-news-viewport
    tabindex="0"
    role="group"
    aria-label="Aktualności — przewijana lista"
  >
    <ul class="news-carousel__track">
      {entries.map((entry) => (
        <li class="news-carousel__slide">
          <NewsCard
            slug={entry.id}
            title={entry.data.tytul}
            date={entry.data.data}
            lead={entry.data.lead}
            image={entry.data.obraz}
            imageAlt={entry.data.obrazAlt}
            headingLevel="h3"
            overlay
          />
        </li>
      ))}
    </ul>
  </div>

  {hasControls && (
    <div class="news-carousel__controls" hidden data-news-controls>
      <button class="news-carousel__button" type="button" data-news-prev>
        <span aria-hidden="true">←</span>
        <span class="visually-hidden">Poprzednie aktualności</span>
      </button>
      <button class="news-carousel__button" type="button" data-news-next>
        <span aria-hidden="true">→</span>
        <span class="visually-hidden">Następne aktualności</span>
      </button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-news-carousel]").forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>("[data-news-viewport]");
    const controls = carousel.querySelector<HTMLElement>("[data-news-controls]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-news-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-news-next]");

    if (!viewport || !controls || !previous || !next) return;

    controls.hidden = false;

    const scrollByPage = (direction: number) => {
      viewport.scrollBy({ left: direction * viewport.clientWidth, behavior: "smooth" });
    };

    const syncButtons = () => {
      const maximum = viewport.scrollWidth - viewport.clientWidth;
      previous.disabled = viewport.scrollLeft <= 4;
      next.disabled = viewport.scrollLeft >= maximum - 4;
    };

    previous.addEventListener("click", () => scrollByPage(-1));
    next.addEventListener("click", () => scrollByPage(1));
    viewport.addEventListener("scroll", syncButtons, { passive: true });
    window.addEventListener("resize", syncButtons);
    syncButtons();
  });
</script>
