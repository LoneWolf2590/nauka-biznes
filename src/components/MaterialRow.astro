---
import { formatDate, formatFileSize } from "../lib/format";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  date: Date;
  type: "raport" | "rekomendacje" | "prezentacja" | "publikacja" | "inne";
  file: string;
  sizeKB: number;
  accessible: boolean;
}

const { title, date, type, file, sizeKB, accessible } = Astro.props;
const typeLabels = {
  raport: "Raport",
  rekomendacje: "Rekomendacje",
  prezentacja: "Prezentacja",
  publikacja: "Publikacja",
  inne: "Materiał",
};
const fileHref = file.startsWith("http") ? file : withBase(file);
const fileExtension = file.split(".").pop()?.toLocaleUpperCase("pl-PL") ?? "PLIK";
---

<article class="material-row">
  <div>
    <p class="material-row__type">{typeLabels[type]}</p>
    <h2>{title}</h2>
  </div>
  <dl>
    <div><dt>Data</dt><dd>{formatDate(date)}</dd></div>
    <div><dt>Format</dt><dd>{fileExtension}, {formatFileSize(sizeKB)}</dd></div>
    <div><dt>Dostępność</dt><dd>{accessible ? "Dostępny cyfrowo" : "Wymaga dostosowania"}</dd></div>
  </dl>
  <a href={fileHref}>
    Pobierz: {title}, {fileExtension}, {formatFileSize(sizeKB)} <span aria-hidden="true">↓</span>
  </a>
</article>
